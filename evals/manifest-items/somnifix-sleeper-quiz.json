  "structure": {
    "title": "SomniFix Sleeper Type Quiz",
    "description": "Take this quick quiz to see if SomniFix Mouth Strips are the right solution for your sleep needs and breathing habits.",
    "questions": [
      {
        "text": "Do you primarily breathe through your mouth while you sleep?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Yes",
          "No",
          "I am not sure"
        ]
      },
      {
        "text": "Do you often wake up with a dry mouth or a parched throat?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Yes",
          "No",
          "Occasionally"
        ]
      },
      {
        "text": "How would you rate your typical sleep quality?",
        "type": "linear_scale",
        "required": true,
        "low": 1,
        "high": 5,
        "lowLabel": "Very Poor",
        "highLabel": "Excellent"
      },
      {
        "text": "Do you or your partner experience issues with your snoring?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "text": "Do you currently use a CPAP machine or an oral appliance for sleep apnea?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Yes, a CPAP machine",
          "Yes, an oral appliance",
          "No"
        ]
      },
      {
        "text": "Do you have a beard or significant facial hair around your mouth?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "text": "What is your main goal for improving your sleep?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Reduce snoring",
          "Stop mouth breathing",
          "Improve energy levels",
          "Better CPAP compliance"
        ]
      },
      {
        "text": "What is your primary sleep position?",
        "type": "multiple_choice",
        "required": false,
        "options": [
          "Back",
          "Side",
          "Stomach",
          "Toss and turn"
        ]
      },
      {
        "text": "Email address to receive your sleeper type results",
        "type": "short_answer",
        "required": true
      }
    ]
  },
