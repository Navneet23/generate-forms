      {
        "text": "How would you describe your skill level in the kitchen?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Beginner / Occasional Cook",
          "Enthusiastic Home Cook",
          "Professional Chef"
        ]
      },
      {
        "text": "What do you find yourself prepping most often? (Select all that apply)",
        "type": "checkboxes",
        "required": true,
        "options": [
          "Vegetables",
          "Meat",
          "Fish",
          "Bread",
          "Fruit"
        ]
      },
      {
        "text": "How would you describe your hand size?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Small",
          "Medium",
          "Large"
        ]
      },
      {
        "text": "Which handle material do you find most aesthetically pleasing?",
        "type": "multiple_choice",
        "required": true,
        "options": [
          "Dark Walnut",
          "Rosewood",
          "Pale Beech"
        ]
      },
      {
