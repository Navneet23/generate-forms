        "required": true,
        "options": [
          "I want something very low maintenance",
          "I'm happy to take care of my tools to keep them sharp"
        ]
      },
      {
        "text": "Where should we send your personalized recommendation?",
        "type": "short_answer",
        "required": true
      }
